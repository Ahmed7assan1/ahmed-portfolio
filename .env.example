# Copy this file to .env and fill in your real values.
# Find these in Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Storage buckets are configured per-field in src/pages/admin/adminConfig.js
# Buckets: avatars, certificates, cv, projects (all public)

# Flowise Chatbot
VITE_FLOWISE_CHATFLOW_ID=your-chatflow-id-here
VITE_FLOWISE_API_HOST=http://localhost:3000
